# Hostinger production settings. These are configuration examples, not credentials.
NODE_ENV=production
REVIEW_MODE=false
SITE_INDEXABLE=true
SITE_URL=https://icgservices.com.au
PORT=3000
# No credentials required: prepare a draft for the visitor to send in their email app.
FORM_DELIVERY=email-app
BUSINESS_EMAIL=admin@icgservices.com.au
# For automatic form delivery, set FORM_DELIVERY=provider and configure a verified sender.
# Supply these in Hostinger environment variables; do not commit real values.
RESEND_API_KEY=
FROM_EMAIL=
# For a duplicate preview: SITE_INDEXABLE=false. Forms may remain usable.
# REVIEW_MODE=true explicitly enables sample-only test forms.
